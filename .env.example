# Example environment variables (do NOT commit sensitive values here)

GITHUB_WEBHOOK_SECRET=replace_with_secret
GITHUB_APP_ID=your_app_id
GITHUB_PRIVATE_KEY_PATH=./keys/app_private_key.pem
DATABASE_URL=sqlite:///./data/db.sqlite3
JWT_SIGNING_KEY=replace_with_a_strong_random_value_or_private_key

# Optional for email/provisioning
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
